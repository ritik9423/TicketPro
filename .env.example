# =============================================================================
# TicketPro Multi-Tenant SaaS Environment Configuration Template
# COPY this file to .env and replace all CHANGE_ME placeholders with secure values
# =============================================================================

# Server Port
PORT=8081

# MySQL Database Settings
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/TicketPro?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Hibernate / JPA (Use 'validate' in production, 'update' in development)
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# Connection Pool Settings
HIKARI_MAX_POOL=20
HIKARI_MIN_IDLE=5

# Flyway Migrations
FLYWAY_ENABLED=true

# JWT Secret & Expiration (Generate a secure 256-bit secret for production)
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_256BIT_SECRET
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173

# Gmail SMTP Mail Configuration (Use an App-Specific Password for Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USER@gmail.com
MAIL_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD
MAIL_FROM=TicketPro Support <support@ticketpro.io>

# Super Admin Initial Credentials
SUPERADMIN_EMAIL=superadmin@ticketpro.io
SUPERADMIN_PASSWORD=CHANGE_ME_SUPERADMIN_PASSWORD

# Webhook Secret for Inbound Email Webhook (SendGrid, Mailgun)
INBOUND_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# =============================================================================
# Mappls Outpost OAuth 2.0 & Token Introspection Configuration
# =============================================================================
OUTPOST_CLIENT_ID=CHANGE_ME_OUTPOST_CLIENT_ID
OUTPOST_CLIENT_SECRET=CHANGE_ME_OUTPOST_CLIENT_SECRET
OUTPOST_CHECK_TOKEN_API=5ba8d74c80999198188ee7dc
OUTPOST_BASE_URL=https://outpost.mappls.com
OUTPOST_TOKEN_URL=https://outpost.mappls.com/api/security/oauth/token
OUTPOST_CHECK_TOKEN_URL=https://outpost.mappls.com/api/security/oauth/check_token
