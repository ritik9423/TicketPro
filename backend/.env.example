# ==========================================
# TicketPro Multi-Tenant SaaS Environment
# ==========================================

# Server Port
PORT=8081

# MySQL Database Settings
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/TicketPro?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root123

# Hibernate / JPA
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# Gmail SMTP Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=Ticket Pro Enterprise Helpdesk

# Super Admin Default Credentials
SUPERADMIN_EMAIL=superadmin@ticketpro.com
SUPERADMIN_PASSWORD=SuperAdmin@123456

# ==========================================
# Mappls Outpost OAuth & Check Token
# ==========================================
OUTPOST_CLIENT_ID=your_mappls_client_id_here
OUTPOST_CLIENT_SECRET=your_mappls_client_secret_here
OUTPOST_CHECK_TOKEN_API=ast1717396434i298196169
